{
  "manifest_version": 3,
  "name": "Listing Writer Vinted V2",
  "version": "2.0.0",
  "description": "Fills the open Vinted sell form from the one item you just prepared. Does not press Sell.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.vinted.com/*",
    "https://*.vinted.com/*",
    "https://hahm-ebay-lister-tau-one.vercel.app/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Vinted V2 settings"
  },
  "content_scripts": [
    {
      "matches": ["https://www.vinted.com/*", "https://*.vinted.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
